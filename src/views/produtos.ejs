<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Produtos</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="layout">

    <aside class="sidebar">

        <div class="logo">
            <h2>Loja</h2>
            <span>Painel Administrativo</span>
        </div>

        <nav>

            <a href="/dashboard">
                Dashboard
            </a>

            <a href="/categorias">
                Categorias
            </a>

            <a href="/produtos" class="active">
                Produtos
            </a>

            <a href="/clientes">
                Clientes
            </a>

            <a href="/pedidos">
                Pedidos
            </a>

        </nav>

        <button class="logout" onclick="logout()">
            Sair
        </button>

    </aside>

    <main class="content">

        <header class="content-header">

            <h1>Produtos</h1>

            <p>
                Gerencie os produtos cadastrados.
            </p>

        </header>

        <div class="form">

            <input
                id="nome"
                type="text"
                placeholder="Nome do produto"
            >

            <input
                id="valor"
                type="number"
                step="0.01"
                placeholder="Valor"
            >

            <input
                id="estoque"
                type="number"
                placeholder="Estoque"
            >

            <select id="categoria">

                <option value="">
                    Selecione uma categoria
                </option>

            </select>

            <button onclick="salvarProduto()">
                Salvar
            </button>

        </div>

        <div class="table-container">

            <table>

                <thead>

                    <tr>

                        <th>ID</th>

                        <th>Nome</th>

                        <th>Valor</th>

                        <th>Estoque</th>

                        <th>Categoria</th>

                        <th width="180">
                            Ações
                        </th>

                    </tr>

                </thead>

                <tbody id="listaProdutos">

                </tbody>

            </table>

        </div>

    </main>

</div>

<script src="/js/produtos.js"></script>

</body>

</html>